### 参考 docker-compose.yml 文件
## 必填你的 Telegram Bot Token
TOKEN=

## postgres 环境变量
## 数据库名称
POSTGRES_DB=bilifeedbot
## 数据库用户名
POSTGRES_USER=bilifeedbot
## 数据库密码
POSTGRES_PASSWORD=bilifeedbot

## Telegram MTProto 应用凭据, 详见 https://core.telegram.org/api/obtaining_api_id
## 建议换成自己在 my.telegram.org 申请的 api_id/api_hash
## 你的 Telegram API ID
TELEGRAM_API_ID=17349
## 你的 Telegram API Hash
TELEGRAM_API_HASH=344583e45741c457fe1862106095a5eb

## telegram-bili-feed-helper 环境变量
## 下载媒体与数据库文件的临时目录
LOCAL_TEMP_FILE_PATH=/data
## Kurigram session 目录（保存 MTProto 会话与更新状态）
TELEGRAM_SESSION_DIR=/data
## Redis 连接 URL
REDIS_URL=redis://redis:6379
## PostgreSQL 连接 URL
DATABASE_URL=postgres://bilifeedbot:bilifeedbot@postgres:5432/bilifeedbot
## 首选的视频编解码器（例如 avc/hev/av01）
# VIDEO_CODEC=
## 视频大小限制（字节）
# VIDEO_SIZE_LIMIT=
## 文件数据库表名
# FILE_TABLE=
## Bilibili API 端点 URL 前缀列表, 逗号分隔
# BILI_API=
## Bilibili UPOS（上传服务器）域名列表, 逗号分隔
# UPOS_DOMAIN=
## FFmpeg 可执行文件路径
# FFMPEG_PATH=
## 文件下载专用代理 URL（如果需要）
# FILE_PROXY=
## HTTP 代理 URL（例如 http://user:pass@host:port 或 socks5://host:port）
# HTTP_PROXY=
## 上传工作线程数（同时上传的文件数）
# UPLOAD_WORKERS=4
## 上传队列总大小
# MAX_QUEUE_SIZE=200
## 单用户/群组最大上传任务队列数
# MAX_USER_TASKS=5
## 单用户/群组限流窗口内请求上限，0 或留空表示不限制
# REQUEST_LIMIT_COUNT=0
## 单用户/群组限流窗口 TTL（秒），例如 86400 表示 24 小时
# REQUEST_LIMIT_TTL=86400
## 设置为 1 以启用文件日志记录
# LOG_TO_FILE=
## 用于创建 Telegraph 页面的 Telegraph 访问令牌
# TELEGRAPH_ACCESS_TOKEN=
## 凭据缓存的生存时间（秒）
# CREDENTIAL_CACHE_TIME=
## 锁缓存的生存时间（秒）
# LOCK_CACHE_TIME=
## 音频数据缓存的生存时间（秒）
# AUDIO_CACHE_TIME=
## 番剧数据缓存的生存时间（秒）
# BANGUMI_CACHE_TIME=
## Opus 数据缓存的生存时间（秒）
# OPUS_CACHE_TIME=
## 直播流数据缓存的生存时间（秒）
# LIVE_CACHE_TIME=
## 已读状态缓存的生存时间（秒）
# READ_CACHE_TIME=
## 回复数据缓存的生存时间（秒）
# REPLY_CACHE_TIME=
## 视频数据缓存的生存时间（秒）
# VIDEO_CACHE_TIME=

#### BEGIN: Bilibili Cookie
## 管理员 Telegram 用户 ID。管理员通过 /login 扫码更新 Bilibili 凭证
# ADMIN_USER_ID=
#### END: Bilibili Cookie
